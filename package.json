{
  "name": "slime-browser",
  "version": "1.5.4",
  "description": "Slime Browser - A Chromium-based browser with built-in adblock and YouTube tools",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder && node build/extract-asar.js",
    "build:win": "electron-builder --win && node build/extract-asar.js"
  },
  "author": "MaSc",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.slime.browser",
    "productName": "Slime Browser",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Slime1.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "Slime1.ico",
      "uninstallerIcon": "Slime1.ico",
      "shortcutName": "Slime Browser",
      "include": "build/installer.nsh"
    },
    "files": [
      "src/**/*",
      "Slime1.ico",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Kovy97",
      "repo": "slime_browser"
    }
  }
}
